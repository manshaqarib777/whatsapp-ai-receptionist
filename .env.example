# Copy to .env.local and fill in. NEVER commit a filled-in file.
# Every variable here is validated at boot by src/lib/env.ts — the app will
# refuse to start if one is missing or malformed.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# NOTE: NODE_ENV is deliberately NOT set here. Next.js sets it itself
# (development for `next dev`, production for `next build`/`next start`).
# Setting it in .env overrides that and makes a production server behave as
# though it were in development — including injecting the dev-tools overlay.

# Public base URL of the app. Used for absolute links and callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Local Postgres runs in Docker on host port 5433 (see docker/docker-compose.yml).
DATABASE_URL=postgresql://war_dev:war_dev_password@localhost:5433/war_dev?schema=public

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Authentication (Milestone 2)
# ---------------------------------------------------------------------------

# Session signing secret. Minimum 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-character-minimum-secret

# From address on outbound mail. No provider is configured yet — in development,
# messages are written to the log (see src/lib/email.ts).
EMAIL_FROM=noreply@whatsapp-receptionist.local

# OAuth providers. Optional — a provider is offered on the sign-in screen only
# when BOTH its id and secret are set. Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------------------

# console — writes messages to the terminal, with the link on its own line.
#           Zero setup. Development only.
# smtp    — real delivery through nodemailer. REQUIRED in production; the app
#           refuses to boot in production with any other value.
EMAIL_TRANSPORT=console

# From address on outbound mail.
EMAIL_FROM=noreply@whatsapp-receptionist.local

# Only needed when EMAIL_TRANSPORT=smtp. Works with any SMTP provider:
#
#   Resend    SMTP_HOST=smtp.resend.com              SMTP_PORT=587  SMTP_USER=resend
#   Postmark  SMTP_HOST=smtp.postmarkapp.com         SMTP_PORT=587
#   SES       SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587
#   Gmail     SMTP_HOST=smtp.gmail.com               SMTP_PORT=587  (app password)
#
# SMTP_USER and SMTP_PASSWORD must be set together or not at all — a half-set
# pair is rejected at boot rather than failing on the first send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS on port 465; leave false for STARTTLS on 587.
SMTP_SECURE=false

# ── Design system gallery ────────────────────────────────────────────────────────
# The component gallery at /design is a development tool, not a product page. It is
# always available in development. In a production BUILD it 404s unless this is set
# to `enabled`, which only the E2E suite does so it can audit production markup.
#
# NEVER set this in a deployment.
DESIGN_GALLERY=disabled
