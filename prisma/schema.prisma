// Milestone 2 — Authentication.
//
// The auth tables originate from `npx @better-auth/cli generate` but are NOT used as
// emitted: the generator produces camelCase column names, no snake_case mapping, and
// no indexes. Every model below is explicitly mapped to satisfy
// .claude/DATABASE_RULES.md, and indexes are added for every foreign key and every
// column used in a WHERE or ORDER BY.
//
// Regenerating with the CLI will overwrite these mappings — regenerate to
// prisma/generated-auth.prisma and merge by hand. See docs/database/schema-change.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A person. Global, NOT tenant-scoped: one user may belong to several
/// organizations with a different role in each. Tenancy lives on Member.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  twofactors  TwoFactor[]
  auditLogs   AuditLog[]

  // Milestone 4. All SetNull on delete: a departing user must not take
  // conversations, messages, or audit history with them.
  assignedConversations Conversation[]             @relation("ConversationAssignee")
  authoredMessages      Message[]                  @relation("MessageAuthor")
  conversationNotes     ConversationNote[]         @relation("NoteAuthor")
  conversationReads     ConversationRead[]         @relation("ConversationReadUser")
  conversationTyping    ConversationTyping[]       @relation("ConversationTypingUser")
  approvedKnowledge     KnowledgeDocumentVersion[] @relation("KnowledgeApprover")
  resourceProfiles      Resource[]
  activities            Activity[]                 @relation("ActivityActor")
  tasks                 Task[]                     @relation("TaskAssignee")
  notifications         Notification[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

/// An active login. Database-backed so revocation is immediate (ADR-0001).
///
/// `activeOrganizationId` is the tenant boundary: it is read from THIS row on every
/// request and never from client input. See SECURITY_RULES.md → Tenant Isolation.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String? @map("active_organization_id") @db.Uuid

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

/// A credential or OAuth provider link. `password` holds the hash for the
/// credential provider; it is never populated for OAuth accounts.
model Account {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @map("account_id")
  /// "credential" for email+password, otherwise the OAuth provider id.
  providerId String @map("provider_id")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens: email verification, password reset, magic link.
/// Rows are deleted on use — single-use is enforced by the library plus this table.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

/// TOTP secret and backup codes. Encrypted at rest by the library.
model TwoFactor {
  id          String @id @default(uuid()) @db.Uuid
  secret      String
  backupCodes String @map("backup_codes")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// THE TENANT. Every business table from Milestone 4 onward carries
/// `organization_id` referencing this table.
///
/// Exempt from the `tenant_id` rule in DATABASE_RULES.md because it *is* the tenant —
/// its own id is the tenant id. Recorded in docs/database/schema-change.md so the
/// exemption is explicit rather than inferred.
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  logo      String?
  metadata  String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  members     Member[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  // Milestone 4. Every business table carries organization_id; Prisma requires
  // the inverse side of each relation to be declared here.
  branches              Branch[]
  whatsappAccounts      WhatsappAccount[]
  contacts              Contact[]
  companies             Company[]
  conversations         Conversation[]
  messages              Message[]
  messageAttachments    MessageAttachment[]
  labels                Label[]
  conversationLabels    ConversationLabel[]
  conversationNotes     ConversationNote[]
  knowledgeSources      KnowledgeSource[]
  knowledgeDocs         KnowledgeDocument[]
  knowledgeVersions     KnowledgeDocumentVersion[]
  knowledgeChunks       KnowledgeChunk[]
  ingestionJobs         IngestionJob[]
  promptTemplates       PromptTemplate[]
  promptVersions        PromptTemplateVersion[]
  aiRuns                AiRun[]
  aiRunCitations        AiRunCitation[]
  services              Service[]
  resources             Resource[]
  availabilityRules     AvailabilityRule[]
  availabilityExc       AvailabilityException[]
  appointments          Appointment[]
  apptReminders         AppointmentReminder[]
  pipelines             Pipeline[]
  pipelineStages        PipelineStage[]
  deals                 Deal[]
  tags                  Tag[]
  taggables             Taggable[]
  activities            Activity[]
  tasks                 Task[]
  notifications         Notification[]
  quoteTemplates        QuoteTemplate[]
  quotes                Quote[]
  quoteLineItems        QuoteLineItem[]
  quoteVersions         QuoteVersion[]
  invoices              Invoice[]
  invoiceLineItems      InvoiceLineItem[]
  payments              Payment[]
  refunds               Refund[]
  paymentEvents         PaymentEvent[]
  workflows             Workflow[]
  workflowVersions      WorkflowVersion[]
  workflowRuns          WorkflowRun[]
  workflowRunSteps      WorkflowRunStep[]
  segments              Segment[]
  messageTemplates      WhatsappMessageTemplate[]
  campaigns             Campaign[]
  campaignRecipients    CampaignRecipient[]
  reviewPlatforms       ReviewPlatform[]
  reviewRequests        ReviewRequest[]
  reviews               Review[]
  conversationReads     ConversationRead[]
  conversationTypings   ConversationTyping[]
  conversationSummaries ConversationSummary[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

/// User ↔ Organization, carrying the role. This is where RBAC lives: a person may
/// be `owner` of one organization and `viewer` of another.
model Member {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// owner | admin | member | viewer — see src/features/auth/permissions.ts
  role String @default("member")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// One membership per user per organization.
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

/// A pending invitation to join an organization.
model Invitation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email     String
  role      String?
  /// pending | accepted | rejected | cancelled
  status    String   @default("pending")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inviterId String @map("inviter_id") @db.Uuid
  user      User   @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// APPEND-ONLY security event log (DATABASE_RULES.md → Audit).
///
/// The repository exposes no update or delete path — not discouraged, absent.
/// There is deliberately no `updatedAt` and no `deletedAt`: an audit row that can be
/// modified is not an audit row.
///
/// `metadata` carries ids and enum values ONLY. Never message bodies, phone numbers,
/// email addresses, tokens, or any other PII (SECURITY_RULES.md → PII).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Null for events with no authenticated actor — a failed sign-in, for example.
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// Null for events outside an organization context, such as signup.
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// e.g. "auth.sign_in", "member.role_changed" — see audit-log.service.ts
  action String

  /// The kind of thing acted upon: "user", "member", "organization".
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  /// JSON. Ids and enums only — no PII.
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

/// Milestone 1. Proves migrations apply and the client round-trips.
/// Exempt from tenant scoping: infrastructure, not tenant data.
model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  @@map("health_checks")
}

// ===========================================================================
// Milestone 4 — Database
//
// Design: docs/database/er-diagram.md (85 tables, all 25 milestones)
// Plan:   docs/milestones/MILESTONE_04_PLAN.md
// Change: docs/database/schema-change.md
//
// Conventions applied to every model below:
//   - organization_id on every business table, NOT NULL      (AD-1)
//   - branch_id on every branch-scoped table, NOT NULL       (AD-1)
//   - deleted_at for soft delete — trash and restore         (AD-4)
//   - redacted_at where PII lives — erasure, a different act (AD-4)
//   - version for optimistic locking on edited entities
//   - money as Decimal(15,4) with a sibling currency column  (AD-3)
//
// Partial unique indexes, CHECK constraints, and the appointment overlap
// exclusion constraint cannot be expressed in Prisma schema syntax. They are
// added as hand-written SQL in the generated migrations — see
// docs/database/schema-change.md → Constraints.
// ===========================================================================

// ---------------------------------------------------------------------------
// Enums
//
// Prisma enums become Postgres enum types, which satisfies DATABASE_RULES.md
// §Constraints ("enforce invariants in the database, not only in code") more
// strongly than a CHECK on a text column, and gives TypeScript exhaustiveness
// for free. Cost: adding a value later needs ALTER TYPE in a migration.
// ---------------------------------------------------------------------------

enum ConversationStatus {
  open
  pending
  resolved
  archived

  @@map("conversation_status")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

enum MessageAuthorType {
  contact
  agent
  ai
  system

  @@map("message_author_type")
}

enum MessageContentType {
  text
  image
  audio
  video
  document
  location
  sticker

  @@map("message_content_type")
}

enum DeliveryStatus {
  queued
  sent
  delivered
  read
  failed

  @@map("delivery_status")
}

enum ContactLifecycleStage {
  lead
  prospect
  customer
  churned

  @@map("contact_lifecycle_stage")
}

enum ChannelStatus {
  active
  disconnected
  suspended

  @@map("channel_status")
}

// ---------------------------------------------------------------------------
// Tenancy — Branch
// ---------------------------------------------------------------------------

/// The second tenancy level. Milestone 18 gives a branch separate calendars,
/// knowledge, and AI, so it is a real isolation boundary and not a label —
/// confirmed with the user on 2026-08-02.
///
/// Every organization auto-provisions one `Main` branch (`is_default`), so a
/// single-branch business is simply an org with one branch. That is what keeps
/// `branch_id` NOT NULL everywhere and avoids two query shapes forever.
model Branch {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  slug String

  /// IANA zone. Scheduling depends on it: a two-city business cannot express
  /// "9am local" without knowing which local.
  timezone String @default("UTC")

  /// Exactly one per organization, enforced by a partial unique index.
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  whatsappAccounts WhatsappAccount[]
  contacts         Contact[]
  companies        Company[]
  conversations    Conversation[]
  labels           Label[]
  knowledgeSources KnowledgeSource[]
  knowledgeDocs    KnowledgeDocument[]
  knowledgeChunks  KnowledgeChunk[]
  promptTemplates  PromptTemplate[]
  aiRuns           AiRun[]
  services         Service[]
  resources        Resource[]
  appointments     Appointment[]
  pipelines        Pipeline[]
  deals            Deal[]
  tags             Tag[]
  activities       Activity[]
  tasks            Task[]
  quoteTemplates   QuoteTemplate[]
  quotes           Quote[]
  invoices         Invoice[]
  workflows        Workflow[]
  segments         Segment[]
  messageTemplates WhatsappMessageTemplate[]
  campaigns        Campaign[]
  reviewPlatforms  ReviewPlatform[]
  reviewRequests   ReviewRequest[]
  reviews          Review[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Channels and contacts
// ---------------------------------------------------------------------------

/// A WhatsApp Business number. `phoneNumberId` is how an inbound webhook
/// resolves to a tenant — DATABASE_RULES.md requires tenancy to come from the
/// session or the WhatsApp phone number id and never from a request body, so
/// this column is globally unique rather than unique per org.
model WhatsappAccount {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// Meta's phone_number_id. The webhook's tenant key.
  phoneNumberId      String @unique @map("phone_number_id")
  wabaId             String @map("waba_id")
  displayPhoneNumber String @map("display_phone_number")

  /// A key into the secret store. NEVER the token itself.
  accessTokenRef String @map("access_token_ref")

  status ChannelStatus @default(active)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  conversations Conversation[]

  @@index([organizationId])
  @@index([branchId])
  @@map("whatsapp_accounts")
}

/// A customer. ONE table — Milestone 6 calls this a Contact and Milestone 10
/// calls it a Customer; `lifecycleStage` carries the distinction. Two tables
/// would mean two identities for the same person.
///
/// PII: displayName, phoneNumber, email. Erasure redacts them in place and sets
/// `redactedAt`, leaving the row skeleton so the audit trail still resolves.
model Contact {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// E.164. Unique per organization among non-deleted rows — a partial unique
  /// index, so a soft-deleted contact does not block re-registration.
  phoneNumber String  @map("phone_number")
  displayName String  @map("display_name")
  email       String?
  locale      String  @default("en")

  lifecycleStage ContactLifecycleStage @default(lead) @map("lifecycle_stage")

  hasConsent Boolean   @default(false) @map("has_consent")
  optedOutAt DateTime? @map("opted_out_at") @db.Timestamptz(3)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  redactedAt DateTime? @map("redacted_at") @db.Timestamptz(3)
  version    Int       @default(1)

  conversations      Conversation[]
  appointments       Appointment[]
  deals              Deal[]
  quotes             Quote[]
  invoices           Invoice[]
  campaignRecipients CampaignRecipient[]
  reviewRequests     ReviewRequest[]
  reviews            Review[]

  @@index([organizationId, phoneNumber])
  @@index([branchId])
  @@index([companyId])
  @@index([organizationId, lifecycleStage])
  @@map("contacts")
}

/// A business a contact belongs to. Carries the VAT number invoicing needs.
model Company {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name      String
  vatNumber String? @map("vat_number")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  contacts Contact[]
  deals    Deal[]

  @@index([organizationId])
  @@index([branchId])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// Inbox — the hot path
// ---------------------------------------------------------------------------

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  whatsappAccountId String          @map("whatsapp_account_id") @db.Uuid
  whatsappAccount   WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Restrict)

  /// SetNull: a departing user must not take conversations with them.
  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  status      ConversationStatus @default(open)
  isPinned    Boolean            @default(false) @map("is_pinned")
  isEscalated Boolean            @default(false) @map("is_escalated")

  /// Denormalised on purpose: the inbox list orders by this, and deriving it
  /// from `messages` per row is the N+1 that would define this product's
  /// performance profile.
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(3)
  unreadCount   Int      @default(0) @map("unread_count")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  redactedAt DateTime? @map("redacted_at") @db.Timestamptz(3)
  version    Int       @default(1)

  messages  Message[]
  labels    ConversationLabel[]
  notes     ConversationNote[]
  aiRuns    AiRun[]
  reads     ConversationRead[]
  typing    ConversationTyping[]
  summaries ConversationSummary[]

  @@index([organizationId, lastMessageAt])
  @@index([branchId, status])
  @@index([contactId])
  @@index([assigneeId])
  @@index([whatsappAccountId])
  @@map("conversations")
}

/// Per-user read receipt. `unreadCount` on Conversation is the denormalised
/// aggregate; this is the per-user marker that lets the UI show "who has read
/// this thread". One row per (user, conversation), upserted on read.
model ConversationRead {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation("ConversationReadUser", fields: [userId], references: [id], onDelete: Cascade)

  /// When this user last read the thread. NULL means "never read".
  lastReadAt DateTime @default(now()) @map("last_read_at") @db.Timestamptz(3)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
  @@index([organizationId])
  @@map("conversation_reads")
}

/// Typing indicator. TTL-expiring: the inbox query filters `expiresAt > now()`
/// and a stale row self-cleans on the next write. A DB row (rather than Redis)
/// works across `next start` instances without new infrastructure.
model ConversationTyping {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation("ConversationTypingUser", fields: [userId], references: [id], onDelete: Cascade)

  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([conversationId, userId])
  @@index([expiresAt])
  @@index([organizationId])
  @@map("conversation_typing")
}

/// PII: `body`. Redacted, never deleted.
model Message {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Meta's message id. Unique per organization — THIS is what makes webhook
  /// processing idempotent under Meta's retries (DATABASE_RULES.md).
  /// Null for outbound messages until the send is acknowledged.
  whatsappMessageId String? @map("whatsapp_message_id")

  direction  MessageDirection
  authorType MessageAuthorType @map("author_type")
  /// The staff user for an agent message; null for contact, ai, and system.
  authorId   String?           @map("author_id") @db.Uuid
  author     User?             @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  contentType MessageContentType @default(text) @map("content_type")
  body        String?            @db.Text

  deliveryStatus DeliveryStatus @default(queued) @map("delivery_status")
  failureReason  String?        @map("failure_reason")

  /// When the conversation's assignee/agent read this message (per-user read
  /// receipts live in ConversationRead; this is the per-message marker).
  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  redactedAt DateTime? @map("redacted_at") @db.Timestamptz(3)

  attachments        MessageAttachment[]
  aiRuns             AiRun[]
  campaignRecipients CampaignRecipient[]

  /// THE webhook idempotency key (DATABASE_RULES.md). Postgres permits many
  /// NULLs in a unique index, which is exactly right: outbound messages have no
  /// WhatsApp id until the send is acknowledged, and they must not collide.
  @@unique([organizationId, whatsappMessageId], map: "uq_messages_organization_id_whatsapp_message_id")
  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("messages")
}

/// The blob lives in object storage; this row holds the key.
/// DATABASE_RULES.md forbids blobs in Postgres.
model MessageAttachment {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  messageId String  @map("message_id") @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  storageKey String  @map("storage_key")
  mimeType   String  @map("mime_type")
  sizeBytes  BigInt  @map("size_bytes")
  fileName   String? @map("file_name")

  /// WhatsApp media URLs are short-lived, so the copy-to-storage step is
  /// visible in the schema rather than discovered at Milestone 6.
  sourceUrlExpiresAt DateTime? @map("source_url_expires_at") @db.Timestamptz(3)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  redactedAt DateTime? @map("redacted_at") @db.Timestamptz(3)

  @@index([messageId])
  @@index([organizationId])
  @@map("message_attachments")
}

model Label {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name  String
  color String @default("neutral")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  conversations ConversationLabel[]

  @@index([organizationId])
  @@index([branchId])
  @@map("labels")
}

model ConversationLabel {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  labelId String @map("label_id") @db.Uuid
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([conversationId, labelId])
  @@index([labelId])
  @@index([organizationId])
  @@map("conversation_labels")
}

/// Internal only. Never sent to the contact — the one thing this table must
/// guarantee, and why notes are not messages with a flag.
model ConversationNote {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  body String @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  @@index([conversationId, createdAt])
  @@index([organizationId])
  @@map("conversation_notes")
}

