// Knowledge base
// ---------------------------------------------------------------------------

enum KnowledgeSourceKind {
  upload
  pdf
  docx
  csv
  website
  faq
  notion
  google_docs

  @@map("knowledge_source_kind")
}

enum KnowledgeVersionStatus {
  draft
  pending_approval
  approved
  archived

  @@map("knowledge_version_status")
}

enum JobStatus {
  queued
  running
  succeeded
  failed

  @@map("job_status")
}

model KnowledgeSource {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  kind KnowledgeSourceKind
  name String

  /// Key into the secret store for sources needing credentials (Notion, Google).
  configRef String? @map("config_ref")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  documents     KnowledgeDocument[]
  ingestionJobs IngestionJob[]

  @@index([organizationId])
  @@index([branchId])
  @@map("knowledge_sources")
}

model KnowledgeDocument {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  sourceId String          @map("source_id") @db.Uuid
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  title String

  /// Upload metadata — the blob lives in object storage (src/lib/storage.ts),
  /// never in Postgres (DATABASE_RULES.md). Null for website/FAQ sources.
  storageKey String? @map("storage_key")
  fileName   String? @map("file_name")
  mimeType   String? @map("mime_type")
  sizeBytes  BigInt? @map("size_bytes")

  /// The version retrieval should use. Null until a version is approved, which
  /// is what stops an unapproved document from ever being cited.
  currentVersionId String? @unique @map("current_version_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  versions      KnowledgeDocumentVersion[]
  ingestionJobs IngestionJob[]

  @@index([organizationId])
  @@index([branchId])
  @@index([sourceId])
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  documentId String            @map("document_id") @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int                    @map("version_number")
  status        KnowledgeVersionStatus @default(draft)

  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedBy   User?     @relation("KnowledgeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)

  extractedText String @map("extracted_text") @db.Text

  /// Derived count + content hash. The checksum makes re-ingestion dedupe and
  /// change detection cheap (a new upload with the same hash is a no-op).
  chunkCount Int?    @map("chunk_count")
  checksum   String? @map("checksum")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chunks        KnowledgeChunk[]
  ingestionJobs IngestionJob[]

  @@unique([documentId, versionNumber])
  @@index([organizationId])
  @@index([documentId, status])
  @@map("knowledge_document_versions")
}

/// Chunks hang off a document VERSION, not a document. Milestone 7 requires
/// approval, so retrieval must be able to see only approved versions — a
/// constraint that is inexpressible if chunks point at the document.
///
/// `embedding` is Unsupported, so it cannot be read or written through the
/// Prisma Client. Inserts and similarity search both go through $queryRaw with
/// tagged-template parameters. Expected, not an oversight.
model KnowledgeChunk {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  documentVersionId String                   @map("document_version_id") @db.Uuid
  documentVersion   KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  ordinal Int
  content String @db.Text

  embedding Unsupported("vector(1536)")?

  /// A model change invalidates every vector — embeddings from different models
  /// are not comparable. Recording both makes re-embedding a job rather than a
  /// redesign.
  embeddingModel String @map("embedding_model")
  dimensions     Int    @default(1536)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  citations AiRunCitation[]

  @@unique([documentVersionId, ordinal])
  @@index([organizationId])
  @@index([branchId])
  @@map("knowledge_chunks")
}

model IngestionJob {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  sourceId String          @map("source_id") @db.Uuid
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// The document/version this job produces, set when the job completes. The
  /// route creates the version row (draft) before enqueueing, so the worker
  /// fills chunks and marks it processed.
  documentId String?                   @map("document_id") @db.Uuid
  document   KnowledgeDocument?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  versionId  String?                   @map("version_id") @db.Uuid
  version    KnowledgeDocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  status   JobStatus @default(queued)
  error    String?   @db.Text
  progress Int?      @default(0)

  startedAt  DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([sourceId, status])
  @@map("ingestion_jobs")
}

