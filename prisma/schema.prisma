/// Milestone 10 calls this a Lead in one place and a Deal in another. One table;
/// `status` and the stage carry the distinction.
model Deal {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  contactId String?  @map("contact_id") @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  stageId String        @map("stage_id") @db.Uuid
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  title String

  valueAmount   Decimal @default(0) @map("value_amount") @db.Decimal(15, 4)
  valueCurrency String  @default("SAR") @map("value_currency")

  status   DealStatus @default(open)
  closedAt DateTime?  @map("closed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  quotes Quote[]

  @@index([organizationId, status])
  @@index([branchId, stageId])
  @@index([contactId])
  @@index([companyId])
  @@map("deals")
}

model Tag {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name  String
  color String @default("neutral")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  taggables Taggable[]

  @@index([organizationId])
  @@index([branchId])
  @@map("tags")
}

/// POLYMORPHIC — a deliberate deviation from DATABASE_RULES.md "foreign keys
/// always", recorded in docs/database/schema-change.md → Deviations.
///
/// A tag applies to contacts, deals, and conversations alike; a join table per
/// target is three tables now and six later. The cost is no referential
/// integrity on `taggableId`. `taggableType` is a Postgres enum, so the type
/// half is constrained even though the id half cannot be.
model Taggable {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  tagId String @map("tag_id") @db.Uuid
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  taggableType TaggableType @map("taggable_type")
  taggableId   String       @map("taggable_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tagId, taggableType, taggableId])
  @@index([taggableType, taggableId])
  @@index([organizationId])
  @@map("taggables")
}

/// POLYMORPHIC, same trade-off as Taggable and recorded in the same place.
model Activity {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  subjectType TaggableType @map("subject_type")
  subjectId   String       @map("subject_id") @db.Uuid

  kind ActivityKind
  body String?      @db.Text

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId, createdAt])
  @@index([organizationId, createdAt])
  @@index([branchId])
  @@index([actorId])
  @@map("activities")
}

/// Milestone 5's dashboard, not Milestone 10.
model Task {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  title       String
  description String?    @db.Text
  dueAt       DateTime?  @map("due_at") @db.Timestamptz(3)
  status      TaskStatus @default(open)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  @@index([organizationId, status])
  @@index([branchId, dueAt])
  @@index([assigneeId, status])
  @@map("tasks")
}

/// Org-scoped, not branch-scoped: a user may be notified about any branch they
/// have access to, and access is an organization-level concept.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind       String
  title      String
  body       String? @db.Text
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid

  readAt DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, readAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Commerce
//
// Every money column is Decimal(15,4) with a sibling currency column (AD-3).
// Scale 4, not 2: unit prices, percentage discounts, and VAT intermediates need
// sub-minor precision, and rounding happens once at the line and document total.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired

  @@map("quote_status")
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  void

  @@map("invoice_status")
}

enum PaymentStatus {
  pending
  succeeded
  failed

  @@map("payment_status")
}

enum PaymentGateway {
  stripe
  hyperpay
  paytabs
  stcpay
  applepay

  @@map("payment_gateway")
}

model QuoteTemplate {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name         String
  bodyTemplate String @map("body_template") @db.Text
  /// Branding: logo key, colours, footer. Presentation, not money.
  branding     Json?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  quotes Quote[]

  @@index([organizationId])
  @@index([branchId])
  @@map("quote_templates")
}

model Quote {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  dealId String? @map("deal_id") @db.Uuid
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  templateId String?        @map("template_id") @db.Uuid
  template   QuoteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Unique per organization among non-deleted rows.
  number String
  status QuoteStatus @default(draft)

  subtotalAmount Decimal @default(0) @map("subtotal_amount") @db.Decimal(15, 4)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(15, 4)
  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(15, 4)
  currency       String  @default("SAR")

  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  lineItems QuoteLineItem[]
  versions  QuoteVersion[]
  invoices  Invoice[]

  @@index([organizationId, status])
  @@index([branchId, createdAt])
  @@index([contactId])
  @@index([dealId])
  @@map("quotes")
}

model QuoteLineItem {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  position    Int
  description String  @db.Text
  quantity    Decimal @default(1) @db.Decimal(15, 4)

  unitPriceAmount Decimal @map("unit_price_amount") @db.Decimal(15, 4)

  /// Rate AND computed amount, both stored at issue time. A historical document
  /// is never recomputed from today's rate — Saudi VAT moved 5% to 15% in 2020.
  taxRate   Decimal @default(0) @map("tax_rate") @db.Decimal(6, 4)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(15, 4)

  lineTotalAmount Decimal @map("line_total_amount") @db.Decimal(15, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([quoteId, position])
  @@index([organizationId])
  @@map("quote_line_items")
}

/// Row-level history. DATABASE_RULES.md requires it for entities users reason
/// about over time; the audit log alone is not enough.
model QuoteVersion {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  versionNumber Int  @map("version_number")
  /// The full quote as it stood, line items included.
  snapshot      Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([quoteId, versionNumber])
  @@index([organizationId])
  @@map("quote_versions")
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  quoteId String? @map("quote_id") @db.Uuid
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  /// Sequential per organization. Several jurisdictions require gapless
  /// numbering; generation is Milestone 12's problem, uniqueness is enforced here.
  number String
  status InvoiceStatus @default(draft)

  subtotalAmount Decimal @default(0) @map("subtotal_amount") @db.Decimal(15, 4)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(15, 4)
  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(15, 4)
  amountPaid     Decimal @default(0) @map("amount_paid") @db.Decimal(15, 4)
  currency       String  @default("SAR")

  issuedAt DateTime? @map("issued_at") @db.Timestamptz(3)
  dueAt    DateTime? @map("due_at") @db.Timestamptz(3)
  paidAt   DateTime? @map("paid_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([organizationId, status])
  @@index([branchId, issuedAt])
  @@index([contactId])
  @@index([quoteId])
  @@map("invoices")
}

model InvoiceLineItem {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position    Int
  description String  @db.Text
  quantity    Decimal @default(1) @db.Decimal(15, 4)

  unitPriceAmount Decimal @map("unit_price_amount") @db.Decimal(15, 4)
  taxRate         Decimal @default(0) @map("tax_rate") @db.Decimal(6, 4)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(15, 4)
  lineTotalAmount Decimal @map("line_total_amount") @db.Decimal(15, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([invoiceId, position])
  @@index([organizationId])
  @@map("invoice_line_items")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  gateway          PaymentGateway
  /// Unique — all five gateways retry their webhooks, so idempotency has to be
  /// structural rather than best-effort.
  gatewayPaymentId String         @unique @map("gateway_payment_id")

  amount   Decimal       @db.Decimal(15, 4)
  currency String        @default("SAR")
  status   PaymentStatus @default(pending)

  capturedAt DateTime? @map("captured_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refunds Refund[]
  events  PaymentEvent[]

  @@index([invoiceId])
  @@index([organizationId, status])
  @@map("payments")
}

model Refund {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  gatewayRefundId String  @unique @map("gateway_refund_id")
  amount          Decimal @db.Decimal(15, 4)
  currency        String  @default("SAR")
  reason          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@index([organizationId])
  @@map("refunds")
}

/// Gateway webhook journal. `payload` NEVER holds card data — storing a PAN
/// would put this system in PCI scope, and the schema forecloses it.
model PaymentEvent {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  gatewayEventId String @unique @map("gateway_event_id")
  kind           String
  payload        Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@index([organizationId])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Automation
// ---------------------------------------------------------------------------

enum WorkflowRunStatus {
  running
  succeeded
  failed
  cancelled

  @@map("workflow_run_status")
}

enum StepStatus {
  pending
  running
  succeeded
  failed
  skipped

  @@map("step_status")
}

enum TemplateApprovalStatus {
  pending
  approved
  rejected

  @@map("template_approval_status")
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled

  @@map("campaign_status")
}

model Workflow {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name      String
  isEnabled Boolean @default(false) @map("is_enabled")

  currentVersionId String? @unique @map("current_version_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  versions WorkflowVersion[]

  @@index([organizationId])
  @@index([branchId, isEnabled])
  @@map("workflows")
}

/// The graph is JSON on the version row, not normalised into node and edge
/// tables. A visual builder saves the whole graph atomically; normalising buys
/// referential integrity nobody queries and costs a multi-table transaction per
/// save. The version row supplies the auditability that is the real requirement.
model WorkflowVersion {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workflowId String   @map("workflow_id") @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  versionNumber Int    @map("version_number")
  /// { nodes, edges, conditions, variables }
  definition    Json
  triggerKind   String @map("trigger_kind")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  runs WorkflowRun[]

  @@unique([workflowId, versionNumber])
  @@index([organizationId])
  @@map("workflow_versions")
}

model WorkflowRun {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workflowVersionId String          @map("workflow_version_id") @db.Uuid
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)

  triggerEntityType String? @map("trigger_entity_type")
  triggerEntityId   String? @map("trigger_entity_id") @db.Uuid

  status WorkflowRunStatus @default(running)
  error  String?           @db.Text

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  steps WorkflowRunStep[]

  @@index([organizationId, status])
  @@index([workflowVersionId])
  @@map("workflow_runs")
}

model WorkflowRunStep {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  workflowRunId String      @map("workflow_run_id") @db.Uuid
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  /// Matches a node id inside WorkflowVersion.definition.
  nodeId String     @map("node_id")
  status StepStatus @default(pending)
  output Json?

  /// Delay nodes. The scheduler polls this across all runs, so it carries a
  /// partial index on status = 'pending'.
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workflowRunId])
  @@index([organizationId])
  @@map("workflow_run_steps")
}

model Segment {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name       String
  /// Filter tree, evaluated against contacts at send time rather than stored as
  /// a materialised member list — a segment is a question, not a snapshot.
  definition Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  campaigns Campaign[]

  @@index([organizationId])
  @@index([branchId])
  @@map("segments")
}

/// Meta must approve template content before it can be sent. A broadcast system
/// that discovers this at send time is a broadcast system that does not send.
model WhatsappMessageTemplate {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name     String
  language String @default("en")

  metaTemplateId  String?                @map("meta_template_id")
  metaStatus      TemplateApprovalStatus @default(pending) @map("meta_status")
  rejectionReason String?                @map("rejection_reason")

  /// Header, body, footer, buttons, and the variable placeholders.
  body Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  campaigns Campaign[]

  @@unique([branchId, name, language])
  @@index([organizationId])
  @@map("whatsapp_message_templates")
}

model Campaign {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  segmentId String  @map("segment_id") @db.Uuid
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Restrict)

  templateId String                  @map("template_id") @db.Uuid
  template   WhatsappMessageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  name   String
  status CampaignStatus @default(draft)

  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(3)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  recipients CampaignRecipient[]

  @@index([organizationId, status])
  @@index([branchId, scheduledFor])
  @@index([segmentId])
  @@index([templateId])
  @@map("campaigns")
}

/// `messageId` links back to `messages`, so a broadcast and a conversation are
/// the same message stream rather than two parallel ones.
model CampaignRecipient {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  campaignId String   @map("campaign_id") @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  messageId String?  @map("message_id") @db.Uuid
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  status        DeliveryStatus @default(queued)
  failureReason String?        @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([organizationId])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// Milestone 16 — Reviews
// ---------------------------------------------------------------------------

enum ReviewPlatformProvider {
  google
  facebook

  @@map("review_platform_provider")
}

enum ReviewRequestStatus {
  created
  sent
  responded
  expired
  cancelled

  @@map("review_request_status")
}

/// Google or Facebook as a row. Connection state lives on the adapter seam
/// (M16 AD-2); the row records which platforms exist and which are connected.
model ReviewPlatform {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name     String
  provider ReviewPlatformProvider
  isConnected Boolean @default(false) @map("is_connected")

  /// A key into the secret store for the OAuth token. NEVER the token itself.
  credentialsRef String? @map("credentials_ref")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  requests ReviewRequest[]
  reviews  Review[]

  @@unique([branchId, provider])
  @@index([organizationId])
  @@map("review_platforms")
}

/// A review asked of a contact, triggered by a completed appointment.
/// Consent is non-negotiable: a request for a non-consenting or opted-out
/// contact is refused (M16 AD-3), matching the M14 broadcast invariants.
model ReviewRequest {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  appointmentId String      @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  platformId String        @map("platform_id") @db.Uuid
  platform   ReviewPlatform @relation(fields: [platformId], references: [id], onDelete: Restrict)

  status ReviewRequestStatus @default(created)

  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  review Review?

  @@unique([appointmentId, platformId])
  @@index([organizationId, status])
  @@index([contactId])
  @@index([platformId])
  @@index([appointmentId])
  @@map("review_requests")
}

/// A review a request yielded. Rating is 1–5; a rating below the feedback
/// threshold (4) is surfaced as needing attention.
model Review {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  requestId String?       @unique @map("request_id") @db.Uuid
  request   ReviewRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  platformId String        @map("platform_id") @db.Uuid
  platform   ReviewPlatform @relation(fields: [platformId], references: [id], onDelete: Restrict)

  rating Int
  text   String? @db.Text

  /// The platform's own review id, when imported. Unique per organization.
  externalReviewId String? @map("external_review_id")

  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  @@index([organizationId, receivedAt])
  @@index([contactId])
  @@index([platformId])
  @@index([requestId])
  @@index([organizationId, externalReviewId])
  @@map("reviews")
}
