// AI engine
// ---------------------------------------------------------------------------

enum AiRunOutcome {
  answered
  escalated
  refused
  failed

  @@map("ai_run_outcome")
}

enum PromptVersionStatus {
  draft
  active
  archived

  @@map("prompt_version_status")
}

/// Branch-scoped: Milestone 18 gives each branch separate AI.
model PromptTemplate {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  key  String
  name String

  currentVersionId String? @unique @map("current_version_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  versions PromptTemplateVersion[]

  @@index([organizationId])
  @@index([branchId, key])
  @@map("prompt_templates")
}

model PromptTemplateVersion {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  templateId String         @map("template_id") @db.Uuid
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  versionNumber Int                 @map("version_number")
  body          String              @db.Text
  status        PromptVersionStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  aiRuns AiRun[]

  @@unique([templateId, versionNumber])
  @@index([organizationId])
  @@map("prompt_template_versions")
}

/// One AI inference. Milestone 8's confidence, intent, and fallback signals land
/// here, and Milestone 22's "AI Usage" reads from it — designing it once now
/// avoids M22 inventing a parallel usage table.
model AiRun {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  outputMessageId String?  @map("output_message_id") @db.Uuid
  outputMessage   Message? @relation(fields: [outputMessageId], references: [id], onDelete: SetNull)

  promptVersionId String?                @map("prompt_version_id") @db.Uuid
  promptVersion   PromptTemplateVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  /// "provider/model" through the AI Gateway, e.g. "anthropic/claude-sonnet-5".
  model  String
  intent String?

  confidence Decimal? @db.Decimal(5, 4)

  inputTokens  Int @default(0) @map("input_tokens")
  outputTokens Int @default(0) @map("output_tokens")

  /// Model pricing is USD while the tenant may bill in SAR, so cost carries its
  /// own currency (AD-3).
  costAmount   Decimal @default(0) @map("cost_amount") @db.Decimal(15, 4)
  costCurrency String  @default("USD") @map("cost_currency")

  latencyMs Int          @map("latency_ms")
  outcome   AiRunOutcome

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  citations AiRunCitation[]

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([conversationId])
  @@map("ai_runs")
}

/// A table, not a JSON column: Milestone 8 requires citation and Milestone 7
/// needs to know which chunks earn their keep. A blob answers neither query.
model AiRunCitation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  aiRunId String @map("ai_run_id") @db.Uuid
  aiRun   AiRun  @relation(fields: [aiRunId], references: [id], onDelete: Cascade)

  knowledgeChunkId String         @map("knowledge_chunk_id") @db.Uuid
  knowledgeChunk   KnowledgeChunk @relation(fields: [knowledgeChunkId], references: [id], onDelete: Cascade)

  similarity Decimal @db.Decimal(6, 5)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([aiRunId])
  @@index([knowledgeChunkId])
  @@index([organizationId])
  @@map("ai_run_citations")
}

/// Conversation Summary. Milestone 6 renders the heuristic summary; Milestone 8's
/// AI Engine writes the LLM-generated version into the same table (model = the
/// generating model, status = lifecycle). One current row per conversation.
model ConversationSummary {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  summary String @db.Text
  /// The generating model, e.g. "heuristic" for M6, "anthropic/claude-sonnet-5" for M8.
  model   String @default("heuristic")
  version Int    @default(1)
  status  String @default("current")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([conversationId, version])
  @@index([organizationId])
  @@map("conversation_summaries")
}

