/// Staff, rooms, and equipment. `userId` is nullable because a treatment room
/// has no login — one of the few nullable columns with a standing justification.
model Resource {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  kind ResourceKind @default(staff)
  name String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]

  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
  @@map("resources")
}

model AvailabilityRule {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// 0 = Sunday .. 6 = Saturday. CHECK constrains the range.
  weekday   Int
  startTime DateTime @map("start_time") @db.Time()
  endTime   DateTime @map("end_time") @db.Time()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([resourceId, weekday])
  @@index([organizationId])
  @@map("availability_rules")
}

model AvailabilityException {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([resourceId, startsAt])
  @@index([organizationId])
  @@map("availability_exceptions")
}

/// Stores BOTH a UTC instant and the IANA zone the booking was made in.
/// UTC alone loses the intent: if a government changes a DST rule, "9am local
/// next month" must still resolve to 9am local.
///
/// Double-booking is prevented by an exclusion constraint on
/// (resource_id, tstzrange(starts_at, ends_at)) — in the database, not by an
/// application check that races under concurrency.
model Appointment {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  contactId String  @map("contact_id") @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  /// IANA zone — the booking intent, not a display preference.
  timezone String

  status AppointmentStatus @default(booked)
  notes  String?           @db.Text

  rescheduledFromId String?      @unique @map("rescheduled_from_id") @db.Uuid
  rescheduledFrom   Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment? @relation("Reschedule")

  /// RFC 5545 RRULE plus a parent link, so an exception to one occurrence does
  /// not require materialising every future instance.
  recurrenceRule     String?       @map("recurrence_rule")
  recurrenceParentId String?       @map("recurrence_parent_id") @db.Uuid
  recurrenceParent   Appointment?  @relation("Recurrence", fields: [recurrenceParentId], references: [id], onDelete: Cascade)
  recurrenceChildren Appointment[] @relation("Recurrence")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  reminders      AppointmentReminder[]
  reviewRequests ReviewRequest[]

  @@index([branchId, startsAt])
  @@index([organizationId, startsAt])
  @@index([contactId])
  @@index([resourceId, startsAt])
  @@index([serviceId])
  @@map("appointments")
}

model AppointmentReminder {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  appointmentId String      @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  sendAt  DateTime       @map("send_at") @db.Timestamptz(3)
  channel String         @default("whatsapp")
  status  ReminderStatus @default(scheduled)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([appointmentId])
  @@index([status, sendAt])
  @@index([organizationId])
  @@map("appointment_reminders")
}

